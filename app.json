{
    "expo": {
        "name": "orion-chat-mobile",
        "slug": "orion-chat-mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "orionchatmobile",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "infoPlist": {
                "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để gửi hình ảnh và video.",
                "NSCameraUsageDescription": "Ứng dụng cần truy cập camera để chụp ảnh và quay video.",
                "NSMicrophoneUsageDescription": "Ứng dụng cần truy cập microphone để quay video có âm thanh."
            }
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "permissions": [
                "android.permission.READ_EXTERNAL_STORAGE",
                "android.permission.WRITE_EXTERNAL_STORAGE",
                "android.permission.READ_MEDIA_IMAGES",
                "android.permission.READ_MEDIA_VIDEO",
                "android.permission.CAMERA"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ],
            "expo-secure-store",
            "@react-native-community/datetimepicker",
            [
                "expo-image-picker",
                {
                    "photosPermission": "Ứng dụng cần truy cập thư viện ảnh để gửi hình ảnh và video.",
                    "cameraPermission": "Ứng dụng cần truy cập camera để chụp ảnh và quay video."
                }
            ],
            "expo-document-picker"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
